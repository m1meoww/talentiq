# --- Server ---
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Security ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MIN=120

# --- Database ---
# If MySQL vars below are left blank, or MySQL is unreachable at boot,
# TalentIQ automatically falls back to a local SQLite database (talentiq.db).
DB_ENGINE=mysql            # mysql | sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=talentiq
MYSQL_PASSWORD=talentiq
MYSQL_DATABASE=talentiq

# --- Uploads ---
UPLOAD_FOLDER=uploads/resumes
MAX_UPLOAD_MB=10
